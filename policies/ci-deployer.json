{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassAnyRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    },
    {
      "Sid": "DeployLambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:InvokeFunction",
        "lambda:UpdateFunctionCode"
      ],
      "Resource": "arn:aws:lambda:us-east-1:111122223333:function:*"
    },
    {
      "Sid": "Artifacts",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::deploy-artifacts/*"
    }
  ]
}
